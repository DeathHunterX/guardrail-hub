# GuardRail MCP Server — environment template
# Copy to .env and change only the values that apply to your setup.
# Every variable below is read by app/core/config (the settings package).
# Full reference: docs/configuration.md
#
# Values shown are the built-in defaults. Vars marked [REQUIRED IN PRODUCTION]
# are enforced at startup when APP_ENV=production (the server refuses to boot
# if they are missing or left at their insecure default).

# =========================================================
# App / Server
# =========================================================
APP_ENV=development            # development | staging | production
APP_DEBUG=true
# APP_NAME and APP_VERSION have defaults; override only if needed.

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8787
MCP_SERVER_PUBLIC_URL=http://localhost:8787

# Deployment mode
MCP_MODE=STANDALONE            # STANDALONE | CONNECTED
MCP_DEPLOYMENT_MODE=SELF_HOSTED_PRIVATE   # HOSTED_PUBLIC | SELF_HOSTED_PRIVATE

# =========================================================
# Auth / Tokens
# =========================================================
TOKEN_AUTHORITY=SELF_MANAGED   # SELF_MANAGED | PLATFORM_ISSUED
TOKEN_ALGORITHM=HS256          # HS256 (shared secret) | RS256 (key pair)

# [REQUIRED IN PRODUCTION] HS256 shared secret. Must be >= 32 chars and NOT the
# default value below when APP_ENV=production.
INTERNAL_TOKEN_SECRET=change-this-secret

TOKEN_ISSUER=guardrail-mcp-local
TOKEN_AUDIENCE=guardrail-mcp
TOKEN_EXPIRES_IN_DAYS=90

# Only for TOKEN_ALGORITHM=RS256 ([REQUIRED IN PRODUCTION] if RS256).
TOKEN_PRIVATE_KEY_PATH=
TOKEN_PUBLIC_KEY_PATH=
JWKS_URL=

# Connected-platform mode. [REQUIRED IN PRODUCTION] when MCP_MODE=CONNECTED
# or TOKEN_AUTHORITY=PLATFORM_ISSUED.
PLATFORM_API_URL=
PLATFORM_API_TOKEN=
PLATFORM_TOKEN_INTROSPECTION_PATH=/internal/tokens/introspect
PLATFORM_AUDIT_PATH=/internal/audit/events
PLATFORM_TIMEOUT_SECONDS=10

# =========================================================
# Storage
# =========================================================
# NONE     = no persistent app database (operations are not stored)
# POSTGRES = local/self-hosted PostgreSQL
# DYNAMODB = AWS DynamoDB or DynamoDB Local
DATABASE_PROVIDER=NONE

# Optional explicit DSN. If set, it takes precedence for POSTGRES.
DATABASE_URL=

# PostgreSQL (used when DATABASE_PROVIDER=POSTGRES).
# POSTGRES_PASSWORD is [REQUIRED IN PRODUCTION] unless DATABASE_URL is set.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=guardrail_hub
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=

# DynamoDB (used when DATABASE_PROVIDER=DYNAMODB).
# For AWS: leave DYNAMODB_ENDPOINT_URL empty and set AWS creds.
# For local: run `docker compose --profile dynamodb up` and point the endpoint at it.
# [REQUIRED IN PRODUCTION] when DYNAMODB: AWS creds OR DYNAMODB_ENDPOINT_URL.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_ENDPOINT_URL=
DYNAMODB_TABLE_PREFIX=guardrail_local

# =========================================================
# Audit & Logging
# =========================================================
AUDIT_MODE=LOCAL               # LOCAL | PLATFORM | BOTH | NONE
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_LOG_FORMAT=jsonl         # jsonl | json
AUDIT_INCLUDE_ARGUMENTS=false
AUDIT_MASK_SECRETS=true

LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                # text | json
LOG_FILE_PATH=./logs/server.log

# =========================================================
# Rate limit & CORS
# =========================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated origins; setting any value enables CORS. Empty = disabled.
# Example: http://localhost:3000,https://app.example.com
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# =========================================================
# Notifications — Slack (outbound)
# =========================================================
# When SLACK_ENABLED=true, the server registers the Slack notification channel
# and posts operation events to SLACK_DEFAULT_CHANNEL. Both SLACK_BOT_TOKEN and
# SLACK_DEFAULT_CHANNEL are then [REQUIRED] and validated at startup.
# The bot (xoxb- token, scope chat:write) must be invited to the channel.
# When false, no channel is registered and no notifications are sent.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# =========================================================
# Tool policy & Security guards
# =========================================================
TOOL_POLICY_PATH=./config/tool-policy.json
ALLOWED_TOOLS_PATH=./config/allowed-tools.json

ALLOW_DANGEROUS_TOOLS=false
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
REQUIRE_APPROVAL_FOR_CRITICAL_RISK=true

WORKSPACE_DIR=./data/workspace
TEMP_DIR=./data/tmp
MAX_FILE_SIZE_MB=10

ALLOW_PATH_TRAVERSAL=false
# Comma-separated glob patterns / extensions.
BLOCKED_FILE_PATTERNS=.env,*.pem,*.key,id_rsa,id_ed25519
ALLOWED_FILE_EXTENSIONS=.txt,.md,.json,.yaml,.yml,.log

ENABLE_SECRET_GUARD=true
ENABLE_COMMAND_GUARD=true
ENABLE_PATH_GUARD=true
DISABLE_SHELL_EXECUTION=true
COMMAND_TIMEOUT_SECONDS=30
MAX_TOOL_EXECUTION_SECONDS=60

# =========================================================
# OWASP ZAP
# =========================================================
# Run ZAP with: docker compose --profile zap up
# The client builds the ZAP URL as http://<PREFIX>-1:<PORT> (e.g. http://owasp-zap-1:8080);
# there is no separate ZAP_API_URL variable.
ZAP_CONTAINER_NAME_PREFIX=owasp-zap
ZAP_API_PORT=8080

# [REQUIRED IN PRODUCTION] Must be changed from the default below.
ZAP_API_KEY=change-this-zap-key

ZAP_AMOUNT_OF_CONTAINERS=1
ZAP_READY_STABLE_SUCCESS_COUNT=3

# Scan phase timeouts (seconds). Increase for large / slow targets.
ZAP_SCAN_TIMEOUT_SECONDS=600
ZAP_SPIDER_TIMEOUT_SECONDS=300
ZAP_PASSIVE_SCAN_TIMEOUT_SECONDS=120
# Per-request timeout when routing through the ZAP proxy.
ZAP_REQUEST_TIMEOUT_SECONDS=30
