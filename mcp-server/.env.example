# GuardRail MCP Server
# Copy this file to .env and change only the values that apply to your setup.

# =========================================================
# Server
# =========================================================
APP_ENV=development
APP_DEBUG=true

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8787
MCP_SERVER_PUBLIC_URL=http://localhost:8787

# Comma-separated origins. Leave empty to disable CORS.
# Example: http://localhost:3000,https://app.example.com
CORS_ALLOW_ORIGINS=*

# =========================================================
# Auth
# =========================================================
# SELF_MANAGED is easiest for self-hosted/local installs.
# PLATFORM_ISSUED is for connected installs backed by GuardRail platform APIs.
TOKEN_AUTHORITY=SELF_MANAGED

# Change this before sharing or deploying the server.
# Use at least 32 characters outside local development.
INTERNAL_TOKEN_SECRET=change-this-secret

# Usually safe to leave as-is.
TOKEN_ISSUER=guardrail-mcp-local
TOKEN_AUDIENCE=guardrail-mcp
TOKEN_EXPIRES_IN_DAYS=90

# =========================================================
# Storage
# =========================================================
# NONE      = no persistent app database yet
# POSTGRES  = local/self-hosted PostgreSQL
# DYNAMODB  = AWS DynamoDB or DynamoDB Local
DATABASE_PROVIDER=NONE

# PostgreSQL
# If you run `docker compose --profile postgres up`, these defaults work.
POSTGRES_DB=guardrail_hub
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guardrail:guardrail@postgres:5432/guardrail_hub

# DynamoDB
# For AWS DynamoDB, leave DYNAMODB_ENDPOINT_URL empty and configure AWS credentials normally.
# For local DynamoDB, run `docker compose --profile dynamodb up` and use http://dynamodb-local:8000.
AWS_REGION=ap-southeast-1
DYNAMODB_ENDPOINT_URL=
DYNAMODB_TABLE_PREFIX=guardrail
DYNAMODB_LOCAL_PORT=8001

# =========================================================
# Audit and Logging
# =========================================================
# LOCAL | PLATFORM | BOTH | NONE
AUDIT_MODE=LOCAL
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_INCLUDE_ARGUMENTS=false
AUDIT_MASK_SECRETS=true

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/server.log

# =========================================================
# Connected Platform Mode
# =========================================================
# Only needed when MCP_MODE=CONNECTED or TOKEN_AUTHORITY=PLATFORM_ISSUED.
MCP_MODE=STANDALONE
PLATFORM_API_URL=
PLATFORM_API_TOKEN=

# =========================================================
# Tool and Runtime Policy
# =========================================================
# These defaults are intentionally conservative.
ALLOW_DANGEROUS_TOOLS=false
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
REQUIRE_APPROVAL_FOR_CRITICAL_RISK=true
DISABLE_SHELL_EXECUTION=true

# Optional paths. Change only if you mount different folders.
TOOL_POLICY_PATH=./config/tool-policy.json
ALLOWED_TOOLS_PATH=./config/allowed-tools.json
WORKSPACE_DIR=./data/workspace
TEMP_DIR=./data/tmp

# =========================================================
# OWASP ZAP
# =========================================================
# Run ZAP with: docker compose --profile zap up
# Inside docker-compose the service name is "zap"; for local dev use localhost.
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=change-this-zap-key

# Scan phase timeouts (seconds). Increase for large / slow targets.
ZAP_SCAN_TIMEOUT_SECONDS=600
ZAP_SPIDER_TIMEOUT_SECONDS=300
ZAP_PASSIVE_SCAN_TIMEOUT_SECONDS=120

# Per-request timeout when routing through ZAP proxy.
ZAP_REQUEST_TIMEOUT_SECONDS=30
